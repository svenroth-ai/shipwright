# Names only. Copy to the env file location (see README) and fill in; never commit real values.
# The real process environment always wins over this file.
SHIPWRIGHT_E2E_PERMISSION_MODE=
SHIPWRIGHT_E2E_WEBUI_DIR=
SHIPWRIGHT_E2E_MAX_MINUTES=
# Optional: the temp project and e2e-report/ are created under this directory (default: OS temp dir).
SHIPWRIGHT_E2E_WORKDIR=
# Optional: a stopped run to continue (a run-<id> folder directly under the workdir); refused unless it recorded the same fixture, package, profile and plugin commit.
SHIPWRIGHT_E2E_RESUME_RUN=
