# Generated by Shipwright — Independent Claude Code review, stage 1 of 2
# Claude Architect Best Practice: "Write in one session, review in a different one."
#
# This stage runs on EVERY pull request, including one raised from a fork, and
# holds NO credentials. It saves the change as an artifact. Stage 2
# (`claude-review-run.yml`, triggered by this workflow completing) holds the API
# key, reads that artifact as data, and posts the verdict.
#
# Why the split: GitHub withholds secrets from `pull_request` runs raised from a
# fork, so a reviewer needing an API key cannot run on them at all — and a job
# that is skipped is scored by GitHub as a SUCCESSFUL required check. A review
# that never happened must never read as a review that passed.
#
# Required status check: `Claude Code Review` is NOT produced here — it is a
# commit status posted by stage 2. That is deliberate: if stage 2 never reports,
# the context is absent, and an absent required context is `pending`, which
# blocks the merge. Silence counts as not passing.
name: Claude Code Review Prepare

on:
  pull_request:
    branches: [main, develop]

permissions:
  contents: read

concurrency:
  group: claude-review-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  prepare:
    name: Prepare review request
    runs-on: ubuntu-latest
    timeout-minutes: 5

    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Save the change as an artifact
        # github context is hoisted into env; the run body never interpolates
        # ${{ github.* }} directly (run-shell-injection guard).
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
        run: |
          set -euo pipefail
          mkdir -p pr-review-request
          # Pinned to the exact SHA this stage saw, so a later push to the fork
          # cannot swap the code out from under the review.
          git diff "$BASE_SHA" "$HEAD_SHA" > pr-review-request/pr.diff
          # Advisory only — stage 2 takes identity from the trusted
          # `workflow_run` event, never from this file.
          printf '{"pr_number":"%s","head_sha":"%s"}' "$PR_NUMBER" "$HEAD_SHA" \
            > pr-review-request/meta.json

      - uses: actions/upload-artifact@v4
        with:
          name: pr-review-request
          path: pr-review-request/
          retention-days: 3
