# Generated by Shipwright — Independent Claude Code review, stage 2 of 2
#
# Triggered by stage 1 (`claude-review.yml`) completing. Because `workflow_run`
# runs in the BASE repository's context, this stage has the API key that a
# fork's `pull_request` run is denied — which is the whole reason fork PRs
# previously got no review at all.
#
# That trust is also the danger: this run holds a secret and a writable token
# while its input is attacker-influenced. Three rules keep it safe:
#
#   1. Never check out the PR head. The checkout below takes the BASE repo at
#      the default branch — the contributor's code is never fetched and never
#      executed here. Only its diff is read, as text.
#   2. Nothing stage 1 produced is trusted. `pull_request` runs stage 1 from the
#      PR head, so a contributor controls it. Its artifact is an AUDIT RECORD;
#      the reviewed diff is fetched from the API here instead.
#   3. Identity comes from the TRUSTED event: the head SHA is taken from
#      `github.event.workflow_run.head_sha`, never from the artifact, so a
#      forged artifact cannot redirect a verdict onto a different pull request.
#
# This workflow is the SOLE producer of the required `Claude Code Review`
# status. If it never posts — crash, cancellation, missing key — the context
# stays absent, and an absent required context is `pending`, which blocks.
# Silence counts as not passing, not as passing.
name: Claude Code Review Run

on:
  workflow_run:
    workflows: ["Claude Code Review Prepare"]
    types: [completed]

permissions:
  contents: read

concurrency:
  group: claude-review-run-${{ github.event.workflow_run.head_sha }}
  cancel-in-progress: true

jobs:
  review:
    name: Review and post verdict
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      statuses: write
      pull-requests: write
      # Read-only, and only to police the required context against a stage-1
      # job renamed by a contributor to manufacture a passing check run.
      checks: read

    steps:
      # RULE 1 — base repo only. No `ref:`, so the PR head is never checked out.
      # Nothing here uses git credentials: `gh` uses GH_TOKEN. Do not leave a
      # writable token in .git/config alongside the LLM key.
      - uses: actions/checkout@v4
        with:
          persist-credentials: false

      - name: Install Claude Code
        run: npm install -g @anthropic-ai/claude-code

      # RULE 3 — resolve identity from the trusted event before anything from
      # the artifact is touched. `workflow_run.pull_requests` is EMPTY for fork
      # PRs, so the number is looked up from the head SHA via the API.
      - name: Resolve pull request from the trusted event
        id: pr
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          HEAD_SHA: ${{ github.event.workflow_run.head_sha }}
          REPO: ${{ github.repository }}
        run: |
          set -euo pipefail
          # A commit can be associated with SEVERAL open PRs. Taking the first
          # would let us review one PR's diff and post a green status onto a SHA
          # that satisfies a DIFFERENT PR's gate. Require exactly one open PR
          # whose CURRENT head is this exact SHA, and fail closed otherwise.
          #
          # We LIST THE BASE REPO'S OPEN PRS and match on head SHA. The prior
          # form asked commits/{sha}/pulls, and that endpoint returns an EMPTY
          # LIST for a pull request raised from a FORK — the commit lives in
          # the fork's object store, not the base repo's. Verified against
          # three real fork PRs on cli/cli: all three resolve through this
          # query and none through commits/{sha}/pulls. The old form left
          # every fork PR unresolvable and permanently red WITHOUT EVER BEING
          # REVIEWED — the exact case this two-stage split exists to fix,
          # inverted into an availability regression no same-repo PR would
          # ever reveal (shipwright-webui#338, doubt-reviewer finding 26).
          #
          # --paginate --slurp (pages flattened by .[][]): a match beyond page
          # 1 must not read as absent, and a SECOND match beyond it must not
          # collapse a two-match ambiguity into an apparent unique one.
          matches=$(gh api --paginate --slurp "repos/$REPO/pulls?state=open&per_page=100" \
            | jq --arg sha "$HEAD_SHA" \
                '[.[][] | select(.state == "open") | select(.head.sha == $sha) | .number]')
          count=$(printf '%s' "$matches" | jq 'length')
          if [ "$count" -ne 1 ]; then
            echo "::error::expected exactly one open PR whose head is $HEAD_SHA, found $count — refusing to post a verdict"
            exit 1
          fi
          echo "number=$(printf '%s' "$matches" | jq -r '.[0]')" >> "$GITHUB_OUTPUT"

      - name: Check stage 1 succeeded
        id: stage1
        env:
          CONCLUSION: ${{ github.event.workflow_run.conclusion }}
        run: |
          set -euo pipefail
          echo "ok=$([ "$CONCLUSION" = "success" ] && echo true || echo false)" >> "$GITHUB_OUTPUT"

      - name: Claude Code Review
        id: review
        if: steps.stage1.outputs.ok == 'true'
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR_NUMBER: ${{ steps.pr.outputs.number }}
          REPO: ${{ github.repository }}
        run: |
          set -euo pipefail
          # The diff is fetched from the API, NOT taken from stage 1's artifact.
          # `pull_request` runs stage 1 from the PR head, so a contributor could
          # otherwise upload a benign diff, have it reviewed, and collect a green
          # status for entirely different code. The artifact is an audit record;
          # it is never the thing reviewed.
          gh api "repos/$REPO/pulls/$PR_NUMBER" \
            -H "Accept: application/vnd.github.v3.diff" > pr.diff
          # A change too large to review in one pass FAILS. It does not skip.
          # The largest changes are exactly the ones that most need reviewing,
          # so letting them through unreviewed inverts the gate. A maintainer
          # who has read it by hand can override with the repository's own
          # waiver; the automated gate never waives itself.
          max_lines=${MAX_DIFF_LINES:-5000}
          lines=$(wc -l < pr.diff)
          if [ "$lines" -gt "$max_lines" ]; then
            echo "::error::diff is $lines lines (limit $max_lines) — too large to review in one pass. Failing closed; split the change or override deliberately."
            exit 1
          fi
          # No `|| true` — a reviewer that crashes must fail the gate, not pass it.
          claude -p "Review this PR diff for bugs, security issues, performance problems, and spec compliance. Focus on high-severity findings only. Return JSON with a findings array." \
            --output-format json \
            --max-tokens 4096 \
            < pr.diff \
            > review-output.json

      - name: Post the review comment
        id: comment
        if: steps.stage1.outputs.ok == 'true'
        uses: actions/github-script@v7
        env:
          PR_NUMBER: ${{ steps.pr.outputs.number }}
        with:
          script: |
            const fs = require('fs');

            // Output that will not parse means NO review happened. Throwing
            // fails the job, which leaves the required context unsatisfied.
            // Returning quietly here is what used to let a broken review pass.
            let review;
            try {
              review = JSON.parse(fs.readFileSync('review-output.json', 'utf8'));
            } catch (e) {
              core.setFailed(
                'Review output was absent or unparseable — no review happened, ' +
                'so the gate fails closed. Original error: ' + e.message);
              return;
            }

            const result = review.result || review;
            let body = '## Claude Code Review\n\n';

            if (result.findings && result.findings.length > 0) {
              body += `Found **${result.findings.length}** finding(s):\n\n`;
              for (const f of result.findings) {
                const icon = f.severity === 'high' ? '🔴' : f.severity === 'medium' ? '🟡' : '🔵';
                body += `${icon} **${f.category || 'general'}** (${f.severity || 'info'})\n`;
                if (f.file) body += `  File: \`${f.file}\`${f.line ? `:${f.line}` : ''}\n`;
                body += `  ${f.finding}\n`;
                if (f.suggestion) body += `  💡 ${f.suggestion}\n`;
                body += '\n';
              }
            } else {
              body += '✅ No significant findings. Code looks good.\n';
            }

            body += '\n---\n_Independent review by Claude Code (separate session from implementation)_';

            // The verdict and its reasons are written onto the change itself,
            // where whoever decides to merge will read them.
            await github.rest.issues.createComment({
              issue_number: Number(process.env.PR_NUMBER),
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: body
            });

      # Post after ordinary failures but never from a cancelled, superseded job:
      # `always()` is true after cancellation and can overwrite the live run.
      - name: Post the Claude Code Review verdict
        if: ${{ !cancelled() }}
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          HEAD_SHA: ${{ github.event.workflow_run.head_sha }}
          REPO: ${{ github.repository }}
          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
          RUN_STARTED_AT: ${{ github.event.workflow_run.run_started_at }}
          STAGE1_OK: ${{ steps.stage1.outputs.ok }}
          PR_NUMBER: ${{ steps.pr.outputs.number }}
          REVIEW_OUTCOME: ${{ steps.review.outcome }}
          COMMENT_OUTCOME: ${{ steps.comment.outcome }}
        run: |
          set -euo pipefail
          : "${RUN_STARTED_AT:?workflow_run.run_started_at is required}"
          # The diff was fetched by PR NUMBER, which tracks the moving head; the
          # verdict lands on the immutable event SHA. If the branch was
          # force-pushed mid-run we reviewed different content than we are about
          # to bless. An A -> B -> A force-push passes a current-head check even
          # though the reviewer saw B, so reject any force-push since stage 1.
          stale=""
          if [ -n "${PR_NUMBER:-}" ]; then
            if ! now=$(gh api "repos/$REPO/pulls/$PR_NUMBER" --jq '.head.sha'); then
              stale="could not verify head — re-run required"
            elif ! forced=$(gh api --paginate --slurp "repos/$REPO/issues/$PR_NUMBER/timeline" \
              | jq --arg t "$RUN_STARTED_AT" \
                  '[.[][] | select(.event == "head_ref_force_pushed")
                          | select(.created_at >= $t)] | length'); then
              stale="could not verify branch history — re-run required"
            elif [ "$now" != "$HEAD_SHA" ] || [ "$forced" != "0" ]; then
              stale="head moved during review — re-run required"
              echo "::error::head moved during the run ($HEAD_SHA -> ${now:-unknown}, $forced force-push(es) since stage 1 began); the review does not describe this commit"
            fi
          fi
          if [ -z "$stale" ]; then
            impostors=$(gh api --paginate --slurp "repos/$REPO/commits/$HEAD_SHA/check-runs" \
              | jq --arg run "$RUN_URL" \
                  '[.[].check_runs[] | select(.name == "Claude Code Review")
                                    | select((.details_url // "") | startswith($run) | not)] | length')
            if [ "$impostors" -ne 0 ]; then
              echo "::error::$impostors check run(s) named 'Claude Code Review' exist on $HEAD_SHA; this workflow is the only permitted producer of that context"
              stale="a second producer is claiming this context — re-run required"
            fi
          fi
          if [ -n "$stale" ]; then
            gh api "repos/$REPO/statuses/$HEAD_SHA" -f state=failure \
              -f context="Claude Code Review" \
              -f description="$stale" \
              -f target_url="$RUN_URL" >/dev/null
            exit 1
          fi
          if [ "$STAGE1_OK" != "true" ]; then
            state=failure; desc="preparation stage failed — nothing was reviewed"
          elif [ "$REVIEW_OUTCOME" = "success" ] && [ "$COMMENT_OUTCOME" = "success" ]; then
            state=success; desc="reviewed — verdict posted on the pull request"
          else
            state=failure; desc="review did not complete — no verdict"
          fi
          gh api "repos/$REPO/statuses/$HEAD_SHA" \
            -f state="$state" \
            -f context="Claude Code Review" \
            -f description="${desc:0:139}" \
            -f target_url="$RUN_URL" >/dev/null
          echo "posted Claude Code Review=$state ($desc)"
          [ "$state" = "success" ]
